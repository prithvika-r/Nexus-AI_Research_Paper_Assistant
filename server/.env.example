# ==========================================
# Nexus Backend Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL with pgvector)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=nexus
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# Express Server Settings
PORT=5000
CLIENT_URL=http://localhost:5173

# AI Model Configuration (Groq Cloud)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Academic Paper Search (Semantic Scholar API)
# Optional: Higher rate limits with an API key from https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# RAG Retrieval Configuration
RAG_TOP_K=6
RAG_CANDIDATE_K=40
RAG_MAX_CANDIDATE_K=120
RAG_CANDIDATES_PER_RESULT=4
RAG_MAX_PER_PAGE=3

# RAG Ranking Weights (Hybrid Semantic + BM25 Lexical + Section Awareness)
RAG_SEMANTIC_WEIGHT=0.65
RAG_LEXICAL_WEIGHT=0.25
RAG_QUALITY_WEIGHT=0.10
RAG_SECTION_WEIGHT=0.10
RAG_QUALITY_TARGET_TOKENS=80

# RAG Generation Settings
RAG_TEMPERATURE=0.1
RAG_MAX_TOKENS=1200
RAG_INSUFFICIENT_EVIDENCE_MESSAGE=The retrieved evidence does not provide enough support to answer this question reliably. Try asking about a specific section or topic in the paper.
RAG_CITATION_PREVIEW_LENGTH=400
